{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "opendockit": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--python",
        ">=3.12",
        "--exclude-newer",
        "2026-11-14T00:00:00Z",
        "--from",
        "opendockit[mcp]==0.3.1",
        "opendockit-mcp"
      ],
      "env": {
        "OPENDOCKIT_MCP_ROOTS": "${OPENDOCKIT_MCP_ROOTS}"
      }
    }
  }
}
